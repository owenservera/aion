{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/owenservera/aion/blob/main/workspace/aion/sessions/roles/02-long-term-planning-alignment/task-to-proof/proof.v1.schema.json",
  "title": "AION task-to-proof receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "task_id",
    "correlation_id",
    "stage",
    "producer",
    "execution",
    "source",
    "artifacts",
    "tests",
    "negative_tests",
    "verification"
  ],
  "properties": {
    "schema": {
      "const": "aion.proof.v1"
    },
    "task_id": {
      "type": "string",
      "pattern": "^AION-TTP-[0-9]{3,}$"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 8
    },
    "stage": {
      "enum": [
        "PUBLISHED",
        "RECEIVED",
        "EXECUTED",
        "VERIFIED",
        "REJECTED"
      ]
    },
    "producer": {
      "type": "string",
      "minLength": 2
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "session_id",
        "model",
        "started_utc",
        "finished_utc"
      ],
      "properties": {
        "engine": {
          "enum": [
            "opencode",
            "zcode"
          ]
        },
        "session_id": {
          "type": "string",
          "minLength": 4
        },
        "model": {
          "type": "string",
          "minLength": 3
        },
        "started_utc": {
          "type": "string",
          "format": "date-time"
        },
        "finished_utc": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "branch",
        "commit_sha"
      ],
      "properties": {
        "repository": {
          "const": "owenservera/aion"
        },
        "branch": {
          "const": "main"
        },
        "commit_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^workspace/aion/"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/test"
      }
    },
    "negative_tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/test"
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "verifier",
        "evidence_refs"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "accepted",
            "rejected"
          ]
        },
        "verifier": {
          "type": "string",
          "minLength": 2
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    }
  },
  "$defs": {
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "status",
        "evidence_ref"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 4
        },
        "status": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 4
        }
      }
    }
  }
}
