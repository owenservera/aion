{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/owenservera/aion/blob/main/workspace/aion/sessions/roles/02-long-term-planning-alignment/task-to-proof/task.v1.schema.json",
  "title": "AION task-to-proof request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "task_id",
    "correlation_id",
    "requested_by",
    "executor",
    "repo",
    "branch",
    "workspace_prefix",
    "objective",
    "allowed_scope",
    "forbidden_scope",
    "acceptance",
    "authorization"
  ],
  "properties": {
    "schema": {
      "const": "aion.task.v1"
    },
    "task_id": {
      "type": "string",
      "pattern": "^AION-TTP-[0-9]{3,}$"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 8
    },
    "requested_by": {
      "type": "string",
      "minLength": 2
    },
    "executor": {
      "enum": [
        "opencode",
        "zcode"
      ]
    },
    "repo": {
      "const": "owenservera/aion"
    },
    "branch": {
      "const": "main"
    },
    "workspace_prefix": {
      "type": "string",
      "pattern": "^workspace/aion/"
    },
    "objective": {
      "type": "string",
      "minLength": 20
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      },
      "uniqueItems": true
    },
    "allowed_scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 2
      },
      "uniqueItems": true
    },
    "forbidden_scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 2
      },
      "uniqueItems": true
    },
    "acceptance": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "minLength": 10
      },
      "uniqueItems": true
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "source",
        "host_execution"
      ],
      "properties": {
        "level": {
          "const": "scoped_git_artifact"
        },
        "source": {
          "type": "string",
          "minLength": 8
        },
        "host_execution": {
          "const": "requires_separate_authorized_operator"
        }
      }
    }
  }
}
