+#!/bin/bash
+# AION-BFF-002 autopush loop -- HARDENED PROPOSAL (NOT DEPLOYED - awaiting AION approval).
+# B3: daemon-level flock (non-blocking) prevents duplicate loop daemons. Per-cycle
+# overlap is enforced inside aion-autopush via /tmp/aion-autopush.lock; this wrapper
+# intentionally does NOT nest flock(1) on that same path (would self-contend and
+# skip every cycle). A failing tick never kills the daemon.
+set -u
+LOG_FILE="/var/log/aion-autopush.log"
+LOOP_LOCK="/tmp/aion-autopush-loop.lock"
+
+exec 200>"$LOOP_LOCK" 2>/dev/null || exit 1
+if ! flock -n 200; then
+  echo "aion-autopush-loop: another loop daemon holds $LOOP_LOCK; exiting" >&2
+  exit 1
+fi
+
+while true; do
+  /usr/local/bin/aion-autopush 2>>"$LOG_FILE" || true
+  sleep 60
+done
