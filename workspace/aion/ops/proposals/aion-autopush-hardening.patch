+#!/bin/bash
+# AION-BFF-002 autopush -- HARDENED PROPOSAL (NOT DEPLOYED - awaiting AION approval).
+# B1 secret-file guard, B2 safe rebase (abort/no-push/alert), B3 flock skip. Never force push.
+# Alerts carry filenames + rule names only; credential values are never logged.
+set -u
+REPO_ROOT="/"
+LOG_FILE="/var/log/aion-autopush.log"
+ALERT_FILE="/var/log/aion-autopush.alert"
+LOCK_FILE="/tmp/aion-autopush.lock"
+
+log() {
+  printf '%s %s\n' "$(date -u '+%F %T UTC')" "$1" >>"$LOG_FILE" 2>/dev/null || true
+}
+
+alert() {
+  local msg="aion-autopush ALERT $(date -u '+%F %T UTC'): $1${2:+ -- $2}"
+  printf '%s\n' "$msg" >>"$LOG_FILE" 2>/dev/null || true
+  printf '%s\n' "$msg" >>"$ALERT_FILE" 2>/dev/null || true
+  printf '%s\n' "$msg" >&2
+}
+
+# B3: non-blocking run lock -- skip quietly (exit 0) when another cycle holds it.
+exec 9>"$LOCK_FILE" 2>/dev/null || exit 1
+if ! flock -n 9; then
+  log "skip: another run holds $LOCK_FILE"
+  exit 0
+fi
+
+cd "$REPO_ROOT" || { alert "cannot cd to $REPO_ROOT"; exit 1; }
+git rev-parse --git-dir >/dev/null 2>&1 || { alert "not a git repo" "$REPO_ROOT"; exit 1; }
+
+git add -A /.gitignore /README.md /workspace/aion 2>>"$LOG_FILE" || {
+  alert "git add failed" "see $LOG_FILE"
+  exit 1
+}
+
+# B1: secret-file guard -- staged path + content refusal. Unstage + alert, never commit.
+# Expected .gitignore entries (managed by a separate reviewed commit, not here):
+# .env*, auth.json, *.pem, *.key, *.p12, *.pfx, id_rsa*, id_dsa*, id_ecdsa*,
+# id_ed25519*, *token*, secrets.json, service-account*.json, .aws/
+check_secret_path() {
+  local f_lc
+  f_lc="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
+  case "$f_lc" in
+    .env|.env.*|*.env|*.env.*) return 0 ;;
+  esac
+  case "$1" in
+    *auth.json|*.pem|*.key|*.p12|*.pfx) return 0 ;;
+  esac
+  case "$f_lc" in
+    *id_rsa*|*id_dsa*|*id_ecdsa*|*id_ed25519*|*token*|*secrets.json|*service-account*.json) return 0 ;;
+  esac
+  return 1
+}
+SECRET_CONTENT_RE='-----BEGIN (RSA |EC |DSA |OPENSSH )?PRIVATE KEY-----|AKIA[0-9A-Z]{16}|gh[pousr]_[A-Za-z0-9_]{20,}|sk-(live|test)-[A-Za-z0-9]{10,}|xox[bpas]-[A-Za-z0-9-]{10,}|aws_secret_access_key|password[[:space:]]*[:=]'
+SECRET_HIT=0
+SECRET_DETAIL=""
+SECRET_ARR=()
+while IFS= read -r -d '' f; do
+  [ -n "$f" ] || continue
+  rule=""
+  if check_secret_path "$f"; then
+    rule="secret-path"
+  elif git show -- ":$f" 2>/dev/null | grep -qE "$SECRET_CONTENT_RE"; then
+    rule="secret-content"
+  fi
+  if [ -n "$rule" ]; then
+    SECRET_HIT=1
+    SECRET_DETAIL="${SECRET_DETAIL}${f}(${rule}) "
+    SECRET_ARR+=("$f")
+  fi
+done < <(git diff --cached --name-only -z --diff-filter=ACMRT 2>/dev/null || true)
+if [ "$SECRET_HIT" -ne 0 ]; then
+  if [ "${#SECRET_ARR[@]}" -gt 0 ]; then
+    git reset -q HEAD -- "${SECRET_ARR[@]}" 2>>"$LOG_FILE" || true
+  fi
+  alert "secret-like staged files refused and unstaged; commit skipped" "$SECRET_DETAIL"
+  exit 1
+fi
+
+if git diff --cached --quiet; then
+  log "no staged changes; skip commit"
+else
+  if ! git commit -q -m "auto: $(date -u '+%F %T UTC')"; then
+    alert "git commit failed" "see $LOG_FILE"
+    exit 1
+  fi
+fi
+
+# B2: failed rebase -> abort, no push, alert + non-zero exit. Never force push.
+if ! git pull -q --rebase origin main 2>>"$LOG_FILE"; then
+  git rebase --abort 2>>"$LOG_FILE" || true
+  alert "git pull --rebase failed; aborted rebase; push skipped" "see $LOG_FILE"
+  exit 1
+fi
+
+# NOTE: never add --force / --force-with-lease here. Push only on clean rebase.
+if ! git push -q origin HEAD:main 2>>"$LOG_FILE"; then
+  alert "git push failed" "see $LOG_FILE"
+  exit 1
+fi
+log "ok: autopush cycle complete"
