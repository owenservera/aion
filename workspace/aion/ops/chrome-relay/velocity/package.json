  "description": "Isolated, offline-safe Track B command client groundwork. No native host or browser integration yet.",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "aion": "./bin/aion.mjs",
    "aiond-dev": "./bin/aiond-dev.mjs",
    "aion-velocity": "./bin/aion-velocity.mjs"
