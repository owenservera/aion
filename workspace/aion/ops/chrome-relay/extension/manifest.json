{
  "manifest_version": 3,
  "name": "AION Chrome Relay Station",
  "version": "0.1.0",
  "description": "Operator console for the AION relay. Truthful status only: transport, proof, approval and evidence are reported separately. The chatgpt.com content script is passive: it acts only on commands sent over its port.",
  "key": "",
  "minimum_chrome_version": "155",
  "permissions": [
    "sidePanel",
    "storage",
    "alarms",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "src/chatgpt/loader.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/chatgpt/content.js",
        "src/chatgpt/correlate.js",
        "src/lib/*.js"
      ],
      "matches": [
        "https://chatgpt.com/*"
      ],
      "use_dynamic_url": false
    }
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/panel/sidepanel.html"
  },
  "action": {
    "default_title": "Open AION Relay Station"
  }
}
