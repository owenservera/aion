{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AION reference-only cross-runtime task handoff v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "handoff_id",
    "work_ref",
    "project_id",
    "parent_work_ref",
    "objective",
    "acceptance",
    "from_principal",
    "target_agent",
    "context_pack_ref",
    "permissions",
    "attempt_policy",
    "created_utc"
  ],
  "properties": {
    "schema": {
      "const": "aion.task-handoff/1"
    },
    "handoff_id": {
      "type": "string",
      "minLength": 6,
      "maxLength": 128
    },
    "work_ref": {
      "type": "string",
      "minLength": 3,
      "maxLength": 1024
    },
    "project_id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 160
    },
    "parent_work_ref": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1024
    },
    "objective": {
      "type": "string",
      "minLength": 8,
      "maxLength": 4000
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 2000
      }
    },
    "from_principal": {
      "type": "string",
      "minLength": 2,
      "maxLength": 160
    },
    "target_agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_definition_ref",
        "deployment_id",
        "binding_revision"
      ],
      "properties": {
        "agent_definition_ref": {
          "type": "string",
          "minLength": 3,
          "maxLength": 256
        },
        "deployment_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128
        },
        "binding_revision": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "context_pack_ref": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1024
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_capabilities",
        "allowed_resources",
        "approval_ref"
      ],
      "properties": {
        "allowed_capabilities": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "allowed_resources": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "approval_ref": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1024
        }
      }
    },
    "attempt_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "idempotency_key",
        "max_attempts",
        "retry_after_unknown_effect"
      ],
      "properties": {
        "idempotency_key": {
          "type": "string",
          "minLength": 8,
          "maxLength": 160
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "retry_after_unknown_effect": {
          "const": false
        }
      }
    },
    "deadline_utc": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "created_utc": {
      "type": "string",
      "format": "date-time"
    }
  }
}
