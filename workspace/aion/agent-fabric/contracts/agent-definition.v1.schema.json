{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/owenservera/aion/blob/design/agent-fabric-20261020/workspace/aion/agent-fabric/contracts/agent-definition.v1.schema.json",
  "title": "AION portable agent definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "agent_id",
    "version",
    "description",
    "mode",
    "instruction",
    "capabilities",
    "skills",
    "model_policy",
    "limits",
    "provenance"
  ],
  "properties": {
    "schema": {
      "const": "aion.agent-definition/1"
    },
    "agent_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "role_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9.-]+$"
      },
      "default": []
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 500
    },
    "mode": {
      "enum": [
        "primary",
        "subagent",
        "all"
      ]
    },
    "instruction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo",
        "path",
        "sha256"
      ],
      "properties": {
        "repo": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\.\\.)(?!.*\\\\)[A-Za-z0-9_./-]+\\.md$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allow",
        "deny"
      ],
      "properties": {
        "allow": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/capability"
          },
          "maxItems": 64
        },
        "deny": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/capability"
          },
          "maxItems": 64
        }
      }
    },
    "skills": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "source_ref",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "source_ref": {
            "type": "string",
            "minLength": 8,
            "maxLength": 1024
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "model_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preference",
        "fallback"
      ],
      "properties": {
        "preference": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9_.-]+/[A-Za-z0-9_.:/-]+(?:#[a-zA-Z0-9_-]+)?$"
        },
        "fallback": {
          "enum": [
            "ask",
            "deny",
            "pre_admission_only"
          ]
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_steps",
        "max_child_depth",
        "max_fanout"
      ],
      "properties": {
        "max_steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "max_child_depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "max_fanout": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_repo",
        "source_commit",
        "declared_utc"
      ],
      "properties": {
        "source_repo": {
          "type": "string",
          "minLength": 3,
          "maxLength": 255
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "declared_utc": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "$defs": {
    "capability": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:-]{0,95}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
