{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AION runtime probe and agent binding facts v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "deployment_id",
    "runtime",
    "runtime_version",
    "agent_definition_ref",
    "role_refs",
    "binding",
    "probes",
    "capabilities",
    "checked_utc"
  ],
  "properties": {
    "schema": {
      "const": "aion.runtime-capabilities/1"
    },
    "deployment_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128
    },
    "runtime": {
      "enum": [
        "opencode-v2",
        "opencode-v1",
        "zcode",
        "zbot",
        "acp",
        "chatgpt-chrome",
        "other"
      ]
    },
    "runtime_version": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 80
    },
    "agent_definition_ref": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    },
    "role_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "revision",
        "adapter",
        "ref"
      ],
      "properties": {
        "status": {
          "enum": [
            "UNBOUND",
            "BOUND_UNVERIFIED",
            "CONFLICT",
            "UNKNOWN"
          ]
        },
        "revision": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "adapter": {
          "type": [
            "string",
            "null"
          ]
        },
        "ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "installed",
        "reachable",
        "authenticated",
        "ready",
        "authorized"
      ],
      "properties": {
        "installed": {
          "$ref": "#/$defs/probe"
        },
        "reachable": {
          "$ref": "#/$defs/probe"
        },
        "authenticated": {
          "$ref": "#/$defs/probe"
        },
        "ready": {
          "$ref": "#/$defs/probe"
        },
        "authorized": {
          "$ref": "#/$defs/probe"
        }
      }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 96
      }
    },
    "checked_utc": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 5,
        "maxLength": 1024
      },
      "maxItems": 32
    }
  },
  "$defs": {
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "evidence_ref"
      ],
      "properties": {
        "state": {
          "enum": [
            "YES",
            "NO",
            "UNKNOWN"
          ]
        },
        "evidence_ref": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1024
        }
      }
    }
  }
}
